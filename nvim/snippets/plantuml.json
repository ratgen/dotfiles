{
  "UML Diagram": {
    "prefix": "uml",
    "body": [
      "@startuml ",
      "title \"$1\"",
      "",
      "$0",
      "",
      "@enduml"
    ],
    "description": "UML Diagram"
  },
  "Component UML": {
    "prefix": "component",
    "body": [
      "component \"$1\" as $2 ",
      "$0"
    ],
    "description": "Component UML"
  },
  "Port": {
    "prefix": "port",
    "body": [
      "port \"$1\" as p$2",
      "$0"
    ],
    "description": "Port"
  },
  "Connection": {
    "prefix": [
      "-",
      "conn"
    ],
    "body": [
      "$1 -- $2",
      "$0"
    ],
    "description": "Connection"
  },
  "Service and connection": {
    "prefix": "service",
    "body": [
      "",
      "() \"$1\" as $2Service",
      "$3 -- $2Service",
      "$4 -( $2Service",
      "$0"
    ],
    "description": "Service and connection"
  },
  "Database": {
    "prefix": "db",
    "body": [
      "database \"$1\" as $2db",
      "$0"
    ],
    "description": "Database"
  },
  "Actor": {
    "prefix": "actorr",
    "body": [
      "actor \"$1\" as $2",
      "$0"
    ],
    "description": "Actor"
  }
}
